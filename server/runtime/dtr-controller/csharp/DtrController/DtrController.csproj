<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DtrController</AssemblyName>
    <RootNamespace>DtrController</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DtrCommonRoot Condition="'$(DtrCommonRoot)' == ''">$(MSBuildThisFileDirectory)../../../common</DtrCommonRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.371">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemoTracer.Tests" />
    <ProjectReference Include="../DtrControllerApi/DtrControllerApi.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(DtrCommonRoot)/csharp/DemoTracerApi/DemoTracerApi.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
