<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DemoTracer</AssemblyName>
    <RootNamespace>DemoTracer</RootNamespace>
    <DtrCommonRoot Condition="'$(DtrCommonRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\runtime\common</DtrCommonRoot>
    <DtrHiderRoot Condition="'$(DtrHiderRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\runtime\dtr-hider</DtrHiderRoot>
    <DtrRandomizerRoot Condition="'$(DtrRandomizerRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\runtime\BotRandomizer</DtrRandomizerRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.378" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" GeneratePathProperty="true" />
    <ProjectReference Include="$(DtrCommonRoot)\csharp\DemoTracerApi\DemoTracerApi.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(DtrHiderRoot)\csharp\DtrHiderApi\DtrHiderApi.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(DtrRandomizerRoot)\BotRandomizerApi\BotRandomizerApi.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(DtrCommonRoot)\econ\cs2-lib-econ-index.v1.json" Link="cs2-lib-econ-index.v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\demotracer-native.json" Link="demotracer-native.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="$(DtrCommonRoot)\..\..\..\LICENSE" LogicalName="DemoTracer.Licenses.AGPL.txt" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES.md" LogicalName="DemoTracer.Licenses.ThirdParty.txt" />
    <EmbeddedResource Include="..\..\UPSTREAM.md" LogicalName="DemoTracer.Licenses.Upstream.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemoTracer.Tests" />
  </ItemGroup>

  <Target Name="CopyZstdDecoder" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(PkgZstdSharp_Port)\lib\net9.0\ZstdSharp.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
