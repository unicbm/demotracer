<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BotRandomizer</AssemblyName>
    <RootNamespace>BotRandomizer</RootNamespace>
    <Version>1.7.0</Version>
    <DtrCommonRoot Condition="'$(DtrCommonRoot)' == ''">$(MSBuildThisFileDirectory).deps\common</DtrCommonRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);.deps\**;BotRandomizerApi\**;tests\**;dist\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.371" />
    <ProjectReference Include="BotRandomizerApi\BotRandomizerApi.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(DtrCommonRoot)\econ\cs2-lib-econ-index.v1.json" Link="cs2-lib-econ-index.v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(DtrCommonRoot)\econ\randomizer-catalog.json" Link="cosmetic_catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="charm_placements.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
